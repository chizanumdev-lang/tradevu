'use client';

import React, { useState, useEffect } from 'react';
import { Save, RefreshCcw, ShieldAlert, CheckCircle2, AlertCircle } from 'lucide-react';
import { DashboardData } from '@/types/dashboard';

export default function AdminPage() {
  const [loading, setLoading] = useState(true);
  const [metrics, setMetrics] = useState<DashboardData | null>(null);
  const [error, setError] = useState<string | null>(null);

  // States for save feedback
  const [savingSection, setSavingSection] = useState<string | null>(null);
  const [message, setMessage] = useState<{type: 'success'|'error', text: string} | null>(null);

  const fetchDashboard = () => {
    setLoading(true);
    fetch('/api/dashboard')
      .then(res => res.json())
      .then(data => {
        if ('error' in data) {
          setError(data.error);
        } else {
          setMetrics(data);
          setError(null);
        }
        setLoading(false);
      })
      .catch(err => {
        setError(err.message);
        setLoading(false);
      });
  };

  useEffect(() => {
    fetchDashboard();
  }, []);

  const handleSave = async (endpoint: string, payload: any, sectionName: string) => {
    setSavingSection(sectionName);
    setMessage(null);
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (!res.ok) throw new Error('Failed to save');
      setMessage({ type: 'success', text: `${sectionName} updated successfully!` });
      fetchDashboard(); // Refresh data
    } catch (err: any) {
      setMessage({ type: 'error', text: `Error updating ${sectionName}: ${err.message}` });
    } finally {
      setSavingSection(null);
      setTimeout(() => setMessage(null), 5000);
    }
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-white flex items-center justify-center p-8">
        <div className="text-4xl font-black animate-pulse uppercase italic">Loading Admin...</div>
      </div>
    );
  }

  if (error || !metrics) {
    return (
      <div className="min-h-screen bg-[#F9FAFB] flex flex-col items-center justify-center p-10 text-center">
        <ShieldAlert className="w-16 h-16 text-red-500 mb-4" />
        <div className="text-xl font-bold text-red-500 mb-4">Database Connection Error</div>
        <p className="text-slate-600 mb-6 font-mono text-sm max-w-lg">{error}</p>
        <p className="mb-6 font-semibold">Make sure you have run the schema.sql in your Supabase SQL Editor.</p>
        <button onClick={() => fetchDashboard()} className="px-6 py-2 bg-slate-900 text-white font-bold rounded-lg shadow hover:opacity-90">
          Try Again
        </button>
      </div>
    );
  }

  // Helper to extract nested values for the form
  const m = metrics;

  return (
    <main className="min-h-screen bg-[#F8FAFC] p-8 md:p-12 font-body text-slate-900">
      <header className="mb-8 flex justify-between items-end bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
        <div>
          <h1 className="text-4xl font-black tracking-tight leading-none text-slate-900">
            Role-Based Admin Console
          </h1>
          <p className="text-sm font-semibold mt-2 text-slate-500">Update dashboard metrics according to your team role.</p>
        </div>
        <div className="flex gap-4">
          <button 
            onClick={() => window.open('/', '_blank')}
            className="px-6 py-3 bg-slate-100 text-slate-700 font-bold rounded-lg hover:bg-slate-200 transition-colors"
          >
            View Dashboard
          </button>
          <button 
            onClick={() => fetchDashboard()}
            className="p-3 bg-white border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 transition-colors shadow-sm"
          >
            <RefreshCcw size={20} />
          </button>
        </div>
      </header>

      {message && (
        <div className={`mb-8 p-4 rounded-lg flex items-center gap-3 font-bold ${message.type === 'success' ? 'bg-green-100 text-green-800 border border-green-200' : 'bg-red-100 text-red-800 border border-red-200'}`}>
          {message.type === 'success' ? <CheckCircle2 size={20} /> : <AlertCircle size={20} />}
          {message.text}
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        {/* ── 1. HR & CEO CONSOLE ────────────────────────────────────── */}
        <AdminSection title="HR / CEO Console" color="bg-purple-600" description="Manage high-level company goals and launch readiness.">
          
          <div className="space-y-6">
            <div className="bg-slate-50 p-6 rounded-xl border border-slate-200">
              <h3 className="font-bold mb-4 flex justify-between items-center">
                <span>Annual Revenue</span>
                <span className="text-xs px-2 py-1 bg-purple-100 text-purple-700 rounded-md">CEO</span>
              </h3>
              <div className="grid grid-cols-2 gap-4">
                <InputGroup label="Goal ($)" value={m.revenueAnnual.goal} onChange={(v) => setMetrics({...m, revenueAnnual: {...m.revenueAnnual, goal: v}})} />
                <InputGroup label="Current ($)" value={m.revenueAnnual.current} onChange={(v) => setMetrics({...m, revenueAnnual: {...m.revenueAnnual, current: v}})} />
              </div>
              <SaveButton 
                onClick={() => handleSave('/api/metrics/revenue/annual', { goal: m.revenueAnnual.goal, current: m.revenueAnnual.current }, 'Annual Revenue')} 
                loading={savingSection === 'Annual Revenue'} 
              />
            </div>

            <div className="bg-slate-50 p-6 rounded-xl border border-slate-200">
              <h3 className="font-bold mb-4 flex justify-between items-center">
                <span>Launch Readiness</span>
                <span className="text-xs px-2 py-1 bg-purple-100 text-purple-700 rounded-md">HR / CEO</span>
              </h3>
              <div className="grid grid-cols-2 gap-4 mb-4">
                <div className="flex flex-col gap-2">
                  <label className="text-xs font-bold text-slate-500 uppercase">Phase</label>
                  <select 
                    value={m.launchStatus.phase}
                    onChange={(e) => setMetrics({...m, launchStatus: {...m.launchStatus, phase: e.target.value}})}
                    className="p-2 border border-slate-300 rounded focus:ring-2 focus:ring-purple-500 font-medium"
                  >
                    <option>Pre-Alpha</option>
                    <option>Alpha</option>
                    <option>Private Beta</option>
                    <option>Public Beta</option>
                    <option>Production Ready</option>
                  </select>
                </div>
                <InputGroup label="Overall Progress (%)" value={m.launchStatus.progress} onChange={(v) => setMetrics({...m, launchStatus: {...m.launchStatus, progress: v}})} />
              </div>
              <div className="grid grid-cols-2 gap-4">
                {['Operations', 'Pay', 'Engineering'].map(dept => {
                  const target = m.launchStatus.deptTargets.find(d => d.name === dept);
                  return (
                    <InputGroup 
                      key={dept}
                      label={`${dept} Target (%)`} 
                      value={target?.progress || 0} 
                      onChange={(v) => {
                        const newTargets = [...m.launchStatus.deptTargets];
                        const idx = newTargets.findIndex(d => d.name === dept);
                        if (idx >= 0) newTargets[idx].progress = v;
                        else newTargets.push({ name: dept, progress: v });
                        setMetrics({...m, launchStatus: {...m.launchStatus, deptTargets: newTargets}});
                      }} 
                    />
                  );
                })}
              </div>
              <SaveButton 
                onClick={() => handleSave('/api/launch/status', { 
                  phase: m.launchStatus.phase, 
                  deptTargets: m.launchStatus.deptTargets,
                }, 'Launch Status')} 
                loading={savingSection === 'Launch Status'} 
              />
            </div>

            {/* Note on Conversion Rates */}
            <div className="bg-yellow-50 border border-yellow-200 p-4 rounded-xl">
              <h3 className="font-bold text-yellow-800 text-sm mb-1">Conversion Rate Approvals</h3>
              <p className="text-xs text-yellow-700">
                Conversion rates are currently calculated dynamically on the server: <br/>
                <b>Ops Rate:</b> {m.opsWeekly.conversionRate}% | <b>Pay Rate:</b> {m.payWeekly.conversionRate}% <br/>
                These values reflect the (Converted Users / Conversations) ratio provided by Team Leads.
              </p>
            </div>
          </div>
        </AdminSection>

        {/* ── 2. OPERATIONS TEAM LEAD ────────────────────────────────── */}
        <AdminSection title="Operations Team Lead" color="bg-blue-600" description="Manage customer acquisition and weekly operational metrics.">
          <div className="space-y-6">
            <div className="bg-slate-50 p-6 rounded-xl border border-slate-200">
              <h3 className="font-bold mb-4 flex justify-between items-center">
                <span>Monthly Customers</span>
              </h3>
              <div className="grid grid-cols-2 gap-4">
                <InputGroup label="Total Current" value={m.customersMonthly.current} onChange={(v) => setMetrics({...m, customersMonthly: {...m.customersMonthly, current: v}})} />
                <InputGroup label="Monthly Goal" value={m.customersMonthly.goal} onChange={(v) => setMetrics({...m, customersMonthly: {...m.customersMonthly, goal: v}})} />
                <InputGroup label="Active Monthly" value={m.customersMonthly.activeMonthly} onChange={(v) => setMetrics({...m, customersMonthly: {...m.customersMonthly, activeMonthly: v}})} />
              </div>
              <SaveButton 
                onClick={() => handleSave('/api/metrics/customers/monthly', { 
                  current: m.customersMonthly.current, 
                  goal: m.customersMonthly.goal,
                  activeMonthly: m.customersMonthly.activeMonthly
                }, 'Monthly Customers')} 
                loading={savingSection === 'Monthly Customers'} 
              />
            </div>

            <div className="bg-slate-50 p-6 rounded-xl border border-slate-200">
              <h3 className="font-bold mb-4 flex justify-between items-center">
                <span>Ops Weekly Score</span>
              </h3>
              <div className="grid grid-cols-2 gap-4">
                <InputGroup label="Weekly Goal" value={m.opsWeekly.weeklyGoal} onChange={(v) => setMetrics({...m, opsWeekly: {...m.opsWeekly, weeklyGoal: v}})} />
                <InputGroup label="Total Visits" value={m.opsWeekly.visits} onChange={(v) => setMetrics({...m, opsWeekly: {...m.opsWeekly, visits: v}})} />
                <InputGroup label="Conversations" value={m.opsWeekly.conversations} onChange={(v) => setMetrics({...m, opsWeekly: {...m.opsWeekly, conversations: v}})} />
                <InputGroup label="Users Converted" value={m.opsWeekly.usersConverted || Math.round((m.opsWeekly.conversations * m.opsWeekly.conversionRate)/100)} onChange={(v) => setMetrics({...m, opsWeekly: {...m.opsWeekly, usersConverted: v}})} />
              </div>
              <SaveButton 
                onClick={() => handleSave('/api/ops/weekly', { 
                  weeklyGoal: m.opsWeekly.weeklyGoal, 
                  visits: m.opsWeekly.visits,
                  conversations: m.opsWeekly.conversations,
                  usersConverted: m.opsWeekly.usersConverted || Math.round((m.opsWeekly.conversations * m.opsWeekly.conversionRate)/100)
                }, 'Ops Weekly')} 
                loading={savingSection === 'Ops Weekly'} 
              />
            </div>
          </div>
        </AdminSection>

        {/* ── 3. PAY TEAM LEAD ───────────────────────────────────────── */}
        <AdminSection title="Tradevu Pay Team Lead" color="bg-emerald-600" description="Manage weekly payments, conversions, and transfer volumes.">
          <div className="space-y-6">
            <div className="bg-slate-50 p-6 rounded-xl border border-slate-200">
              <h3 className="font-bold mb-4 flex justify-between items-center">
                <span>Pay Weekly Score</span>
              </h3>
              <div className="grid grid-cols-2 gap-4">
                <InputGroup label="Weekly Goal" value={m.payWeekly.weeklyGoal} onChange={(v) => setMetrics({...m, payWeekly: {...m.payWeekly, weeklyGoal: v}})} />
                <InputGroup label="Conversations" value={m.payWeekly.conversations} onChange={(v) => setMetrics({...m, payWeekly: {...m.payWeekly, conversations: v}})} />
                <InputGroup label="Users Converted" value={m.payWeekly.usersConverted || Math.round((m.payWeekly.conversations * m.payWeekly.conversionRate)/100)} onChange={(v) => setMetrics({...m, payWeekly: {...m.payWeekly, usersConverted: v}})} />
              </div>
              
              <div className="mt-6 pt-4 border-t border-slate-200">
                <h4 className="text-sm font-bold text-slate-700 mb-4">Transfer Volumes</h4>
                <div className="grid grid-cols-2 gap-4">
                  <InputGroup 
                    label="LCY Transfers" 
                    value={m.payWeekly.transfers.find(t => t.label.includes('LCY'))?.value || 0} 
                    onChange={(v) => {
                      const newTransfers = [...m.payWeekly.transfers];
                      const idx = newTransfers.findIndex(t => t.label.includes('LCY'));
                      if (idx >= 0) {
                        newTransfers[idx].value = v;
                        newTransfers[idx].current = v;
                      }
                      setMetrics({...m, payWeekly: {...m.payWeekly, transfers: newTransfers}});
                    }} 
                  />
                  <InputGroup 
                    label="FCY Transfers" 
                    value={m.payWeekly.transfers.find(t => t.label.includes('FCY'))?.value || 0} 
                    onChange={(v) => {
                      const newTransfers = [...m.payWeekly.transfers];
                      const idx = newTransfers.findIndex(t => t.label.includes('FCY'));
                      if (idx >= 0) {
                        newTransfers[idx].value = v;
                        newTransfers[idx].current = v;
                      }
                      setMetrics({...m, payWeekly: {...m.payWeekly, transfers: newTransfers}});
                    }} 
                  />
                </div>
              </div>

              <SaveButton 
                onClick={() => handleSave('/api/pay/weekly', { 
                  weeklyGoal: m.payWeekly.weeklyGoal, 
                  conversations: m.payWeekly.conversations,
                  usersConverted: m.payWeekly.usersConverted || Math.round((m.payWeekly.conversations * m.payWeekly.conversionRate)/100),
                  lcyTransfers: m.payWeekly.transfers.find(t => t.label.includes('LCY'))?.current || 0,
                  fcyTransfers: m.payWeekly.transfers.find(t => t.label.includes('FCY'))?.current || 0
                }, 'Pay Weekly')} 
                loading={savingSection === 'Pay Weekly'} 
              />
            </div>
          </div>
        </AdminSection>

        {/* ── 4. ENGINEERING TEAM LEAD ───────────────────────────────── */}
        <AdminSection title="Engineering Team Lead" color="bg-orange-500" description="Manage system health and project milestones.">
          <div className="space-y-6">
            <div className="bg-slate-50 p-6 rounded-xl border border-slate-200">
              <h3 className="font-bold mb-4 flex justify-between items-center">
                <span>System Health</span>
              </h3>
              <div className="grid grid-cols-2 gap-4">
                {m.engineering.health.map((h, hIdx) => (
                  <InputGroup 
                    key={hIdx}
                    label={h.label} 
                    value={h.value} 
                    type="text"
                    onChange={(v) => {
                      const newHealth = [...m.engineering.health];
                      newHealth[hIdx].value = v;
                      setMetrics({...m, engineering: {...m.engineering, health: newHealth}});
                    }} 
                  />
                ))}
              </div>
            </div>

            <div className="bg-slate-50 p-6 rounded-xl border border-slate-200">
              <h3 className="font-bold mb-4 flex justify-between items-center">
                <span>Active Projects</span>
              </h3>
              {m.engineering.projects.map((project, idx) => (
                <div key={idx} className="mb-6 pb-6 border-b border-slate-200 last:border-0 last:mb-0 last:pb-0">
                  <h4 className="text-xs font-bold text-slate-500 mb-2 uppercase">Project {idx + 1}</h4>
                  <div className="grid grid-cols-2 gap-4 mb-2">
                    <InputGroup type="text" label="Project Name" value={project.name} onChange={(v) => {
                      const np = [...m.engineering.projects]; np[idx].name = v;
                      setMetrics({...m, engineering: {...m.engineering, projects: np}});
                    }} />
                    <InputGroup type="text" label="Status" value={project.status} onChange={(v) => {
                      const np = [...m.engineering.projects]; np[idx].status = v;
                      setMetrics({...m, engineering: {...m.engineering, projects: np}});
                    }} />
                  </div>
                  <div className="grid grid-cols-2 gap-4">
                    <InputGroup label="Progress (%)" value={project.progress} onChange={(v) => {
                      const np = [...m.engineering.projects]; np[idx].progress = v;
                      setMetrics({...m, engineering: {...m.engineering, projects: np}});
                    }} />
                    <InputGroup type="text" label="ETA" value={project.eta} onChange={(v) => {
                      const np = [...m.engineering.projects]; np[idx].eta = v;
                      setMetrics({...m, engineering: {...m.engineering, projects: np}});
                    }} />
                  </div>
                </div>
              ))}
              
              <SaveButton 
                onClick={() => handleSave('/api/engineering/milestone', { 
                  health: m.engineering.health,
                  projects: m.engineering.projects.map(p => ({
                    name: p.name,
                    status: p.status,
                    dateLabel: p.status === 'Live' ? 'Deployed' : 'Target',
                    dateValue: p.eta || p.dateValue
                  }))
                }, 'Engineering Data')} 
                loading={savingSection === 'Engineering Data'} 
              />
            </div>
          </div>
        </AdminSection>

      </div>
    </main>
  );
}

// ── Components ────────────────────────────────────────────────────────

function AdminSection({ title, color, description, children }: { title: string, color: string, description: string, children: React.ReactNode }) {
  return (
    <section className="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 overflow-hidden relative">
      <div className={`absolute top-0 left-0 w-full h-1 ${color}`}></div>
      <h2 className="text-2xl font-black text-slate-900 mb-2">{title}</h2>
      <p className="text-slate-500 text-sm mb-6">{description}</p>
      {children}
    </section>
  );
}

function InputGroup({ label, value, onChange, type = "number" }: { label: string, value: any, onChange: (v: any) => void, type?: string }) {
  return (
    <div className="flex flex-col gap-1.5">
      <label className="text-xs font-bold text-slate-500 uppercase">{label}</label>
      <input 
        type={type}
        value={value}
        onChange={(e) => onChange(type === 'number' ? parseFloat(e.target.value) || 0 : e.target.value)}
        className="p-2 border border-slate-300 rounded focus:ring-2 focus:ring-slate-900 focus:outline-none font-medium text-slate-800"
      />
    </div>
  );
}

function SaveButton({ onClick, loading }: { onClick: () => void, loading: boolean }) {
  return (
    <button 
      onClick={onClick}
      disabled={loading}
      className="mt-6 w-full py-3 bg-slate-900 text-white font-bold rounded-lg shadow-sm hover:opacity-90 transition-opacity flex items-center justify-center gap-2 disabled:opacity-50"
    >
      {loading ? 'Saving...' : 'Save Changes'} <Save size={18} />
    </button>
  );
}
